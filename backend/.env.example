# ── Server ──────────────────────────────────────────────────
NODE_ENV=production
PORT=7860
# 127.0.0.1 behind nginx (production); 0.0.0.0 to test from a phone on your Wi-Fi
HOST=127.0.0.1

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgres://alayn_user:CHANGE_ME@localhost:5432/alayn_prod
# Set to 'true' only if connecting via SSL (e.g., Heroku, managed PG)
DB_SSL=false

# ── Secrets (generate with: openssl rand -hex 48) ────────────
JWT_SECRET=CHANGE_ME_48_BYTES_HEX
PG_ENC_KEY=CHANGE_ME_32_BYTES_HEX
PHONE_HMAC_KEY=CHANGE_ME_32_BYTES_HEX
API_SECRET=CHANGE_ME_32_BYTES_HEX

# ── Cookies ──────────────────────────────────────────────────
# 'true' whenever the site is served over HTTPS (production); 'false' only for local http://
COOKIE_SECURE=true

# ── CORS ─────────────────────────────────────────────────────
# The site's own origin is always allowed. List only OTHER frontends that call
# this API, comma-separated (e.g. a GitHub Pages copy). Production example:
CORS_ORIGIN=https://al-ayn.srv1956050.hstgr.cloud

# ── Telegram ─────────────────────────────────────────────────
# Leave empty to run without the bot (Telegram features show "not enabled")
TELEGRAM_BOT_TOKEN=

# ── Superadmin accounts (used only by scripts/bootstrap-superadmin.js) ──
# First superadmin
SUPERADMIN_PHONE_1=+9647XXXXXXXXX
SUPERADMIN_PIN_1=CHOOSE_YOUR_PIN
SUPERADMIN_NAME_1=مدير التطبيق

# Second superadmin (optional — leave blank to skip)
SUPERADMIN_PHONE_2=+9647YYYYYYYYY
SUPERADMIN_PIN_2=CHOOSE_YOUR_PIN
SUPERADMIN_NAME_2=مدير التطبيق 2
