[Unit]
Description=Waman Ahyaha donation tracker API (waman-ahyaha.srv1956050.hstgr.cloud)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=waman
Group=waman
WorkingDirectory=/opt/waman-ahyaha/backend
# Secrets, DATABASE_URL, superadmin bootstrap values. root:waman 0640.
EnvironmentFile=/etc/waman-ahyaha/waman-ahyaha.env
Environment=NODE_ENV=production
Environment=PORT=7860
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/env node server.js
Restart=always
RestartSec=3

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
