{
  "expo": {
    "name": "ومن أحياها",
    "slug": "waman-ahyaha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wamanahyaha",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F7F9",
    "ios": {
      "bundleIdentifier": "com.wamanahyaha.app",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ar",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.wamanahyaha.app",
      "adaptiveIcon": {
        "backgroundColor": "#1D6B79",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "locales": {
      "ar": {
        "CFBundleDisplayName": "ومن أحياها"
      },
      "en": {
        "CFBundleDisplayName": "Waman Ahyaha"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true,
          "supportedLocales": [
            "ar"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1D6B79",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0F2A31",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج الوصول إلى الصور لإرفاق صورة بإعلان الحملة. Photo access lets campaign staff attach a picture to an announcement.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://waman-ahyaha.srv1956050.hstgr.cloud",
      "privacyUrl": "https://waman-ahyaha.srv1956050.hstgr.cloud/privacy.html"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
